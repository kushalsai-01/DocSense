apiVersion: v1
kind: Secret
metadata:
  name: docsense-secrets
  namespace: docsense
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME_strong_password"
  JWT_SECRET: "CHANGE_ME_64_char_random_string"
  JWT_REFRESH_SECRET: "CHANGE_ME_64_char_random_string"
  DATABASE_URL: "postgresql://docsense:CHANGE_ME_strong_password@postgres:5432/docsense"
  OPENAI_API_KEY: "CHANGE_ME_or_GEMINI"
  LANGCHAIN_API_KEY: "CHANGE_ME_from_smith.langchain.com"
