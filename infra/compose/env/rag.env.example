# Embeddings
OPENAI_API_KEY=CHANGE_ME
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Qdrant (primary vector store)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Pinecone (optional alternative vector backend)
# VECTOR_BACKEND=pinecone
PINECONE_API_KEY=optional_get_from_app.pinecone.io
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX=docsense

# Retrieval settings
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K_RESULTS=10
HYBRID_SEARCH_ALPHA=0.7   # 0=pure BM25, 1=pure semantic

# RAGAS evaluation (requires OpenAI key above)
RAGAS_ENABLED=true

# Query history (similar past queries)
QUERY_HISTORY_ENABLED=true
QUERY_HISTORY_COLLECTION=query_history

# Logging
LOG_LEVEL=info
