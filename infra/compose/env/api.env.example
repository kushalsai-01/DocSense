NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://docsense:CHANGE_ME@postgres:5432/docsense

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME_run_openssl_rand_-base64_64
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_-base64_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Internal services
AGENT_SERVICE_URL=http://agent-service:8100
RAG_SERVICE_URL=http://rag-service:8000

# Redis
REDIS_URL=redis://redis:6379

# Upload
UPLOAD_MAX_SIZE_MB=50
UPLOAD_DIR=/app/uploads

# CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Logging
LOG_LEVEL=info
