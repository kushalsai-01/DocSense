APP_ENV=development
HTTP_PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=docsense
DB_PASSWORD=docsense_dev_password
DB_NAME=docsense
DB_SSLMODE=disable

STORAGE_DIR=/data
MAX_UPLOAD_BYTES=26214400

RAG_SERVICE_URL=http://rag:8000
RAG_SERVICE_TIMEOUT=60s

# Agent service (set AGENT_ENABLED=false to bypass agent layer)
AGENT_SERVICE_URL=http://agent:8100
AGENT_SERVICE_TIMEOUT=90s
AGENT_ENABLED=true